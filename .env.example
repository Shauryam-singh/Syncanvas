# Server
PORT=8080
NODE_ENV=development
WS_PATH=/ws

# Storage: auto (Postgres when reachable, memory otherwise), postgres, or memory
STORE=auto
DATABASE_URL=postgres://syncanvas:syncanvas@localhost:5432/syncanvas

# Redis is reserved for cross-gateway fan-out; the single gateway does not use it yet
REDIS_URL=redis://localhost:6379

# Auth: change the secret before exposing the gateway
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=604800
INVITE_TTL_SECONDS=604800

# Rooms and access
PUBLIC_DEMO_ROOM=demo
CORS_ORIGIN=*

# Presence and operation limits
PRESENCE_TTL_MS=60000
PRESENCE_SWEEP_MS=5000
MAX_OPS_PER_BATCH=1000

# Test-only: enables the Postgres integration suite (npm run test -w @syncanvas/server)
# TEST_DATABASE_URL=postgres://syncanvas:syncanvas@localhost:5432/syncanvas_test
